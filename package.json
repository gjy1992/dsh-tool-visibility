{
  "name": "@rayfalling/dsh-tool-visibility",
  "version": "0.6.0",
  "description": "Control which tool schemas are injected into the DeepSeek Harness model context, with user-defined tool groups for progressive disclosure: each enabled group exposes exactly one group_<key> tool (its description IS the group intro), and calling it discloses the group's tools to that session only. Settings-page UI + tool_visibility manager tool; persisted state; framework-native tools.restrict filter.",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./client": {
      "types": "./src/client.d.ts",
      "default": "./src/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin",
    "tools",
    "context",
    "token"
  ],
  "author": "gjy1992",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gjy1992/dsh-tool-visibility.git"
  },
  "homepage": "https://github.com/gjy1992/dsh-tool-visibility#readme",
  "bugs": {
    "url": "https://github.com/gjy1992/dsh-tool-visibility/issues"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-connection": "^0.1.5-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.5-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-scope": "^0.1.5-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.5-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2 || ^0.2.0-rc.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-scope": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
